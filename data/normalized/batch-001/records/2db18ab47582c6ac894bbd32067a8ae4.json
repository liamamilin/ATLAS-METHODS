      {
        "id": "point-edit",
        "goal": "对只需改一行、一个词或一个段落的请求做最小改动。",
        "when": "模式诊断为 C，例如用户只要求修正某一行。",
        "inputs": [
          "待改文案",
          "用户指出的具体位置"
        ],
        "outputs": [
          "仅改动过的行",
          "每处改动的理由"
        ],
        "steps": [
          {
            "action": "只改被要求的内容加上其最小邻近范围，其余保持原样；返回改动行并说明理由。",
            "when": "点编辑模式。",
            "rationale": "避免把局部请求扩大成全面改写。",
            "evidence": [
              {
                "path": "skills/copy-editing/SKILL.md",
                "section": "Core Philosophy",
                "line_start": 25,
                "line_end": 25
              }
            ]
