    "tasks": [
      {
        "id": "tdd-cycle",
        "goal": "在写生产代码前先写会失败的测试，按 RED→GREEN→REFACTOR 循环推进，最终得到覆盖新行为、且项目整套测试全部通过的实现。",
        "when": "实现任何新功能、修复 bug、重构或改变行为时；一次性原型、生成代码、配置文件为例外，需先征询人类搭档。",
        "inputs": [
          "期望的行为或期望的 API 设想",
          "项目现有测试命令与测试套件",
          "（若有）可复现 bug 的失败场景"
        ],
        "outputs": [
          "每个新函数/方法对应的测试",
          "让测试通过的最小生产代码",
          "保持测试全部通过的重构后代码",
          "按名列出所有失败的测试报告（含非本次改动导致的失败）"
        ],
        "steps": [
          {
            "action": "写一个最小测试表达期望行为：名称描述行为、只测一件事（名称里出现“and”就拆分）、使用真实代码，mock 仅在不可避免时使用。",
            "when": "每个新行为或新功能开始实现前",
            "rationale": "测试先行，才能证明该测试能够捕获缺失的功能",
            "evidence": [
              {
                "path": "skills/test-driven-development/SKILL.md",
                "line_start": 71,
                "line_end": 111
              },
              {
                "path": "skills/test-driven-development/SKILL.md",
                "line_start": 208,
                "line_end": 214
              }
            ]
          },
          {
            "action": "运行该测试并确认它失败：失败信息符合预期、原因是功能缺失而非拼写错误；若测试直接通过，说明测的是已有行为，应修改测试；若测试报错，先修复错误并重跑，直到它以正确方式失败。",
            "when": "写好 RED 测试后（强制，不得跳过）",
            "rationale": "没有亲眼看到失败，就不知道测试是否测对了东西",
            "evidence": [
              {
                "path": "skills/test-driven-development/SKILL.md",
                "line_start": 12,
                "line_end": 12
              },
              {
                "path": "skills/test-driven-development/SKILL.md",
                "line_start": 113,
                "line_end": 128
              }
            ]
          },
          {
            "action": "写刚好能让测试通过的最简代码；不添加测试之外的功能，不顺手重构其他代码，也不做超出测试的“改进”。",
            "when": "RED 已按预期验证失败后",
            "rationale": "让实现受测试约束，避免过度设计（YAGNI）",
            "evidence": [
              {
                "path": "skills/test-driven-development/SKILL.md",
                "line_start": 130,
                "line_end": 166
              }
            ]
          },
          {
            "action": "再次运行测试：确认本测试通过、其他测试仍通过、输出干净（无错误与警告）；本测试失败就修改代码，不要修改测试；其他测试失败应立即修复。随后运行项目的完整测试命令（如 pytest、npm test、cargo test，取决于仓库），即使任务只点名一个测试文件；报告须按名列出该次运行暴露的任何失败，包括并非由本次改动引起的失败。",
            "when": "GREEN 实现之后（强制）",
            "rationale": "单个测试通过不等于整套测试通过；看到了失败却在报告中不提，等于用省略伪造报告",
            "evidence": [
