        "outputs": [
          "动画 GIF 文件（emoji 用 128x128，消息用 480x480）"
        ],
        "steps": [
          {
            "action": "创建 GIFBuilder，指定 width、height、fps；emoji 使用 128x128，消息使用 480x480，fps 在 10-30 之间。",
            "when": "开始制作 GIF 时。",
            "rationale": "尺寸、FPS、颜色数和时长需符合 Slack 要求；较低 FPS 文件更小。"
          },
          {
            "action": "逐帧生成 PIL Image，用 ImageDraw 的 ellipse、polygon、line、rectangle 等图元绘制动画，并调用 builder.add_frame(frame) 加入构建器（也可用 add_frames 批量加入）。",
            "when": "生成每一帧时。",
            "rationale": null,
            "evidence": [
              {
                "path": "skills/slack-gif-creator/SKILL.md",
                "line_start": 60,
