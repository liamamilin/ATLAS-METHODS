      {
        "id": "quick-pass",
        "goal": "在不跑完整七轮时做较快的词级、句级、段级检查。",
        "when": "不需要完整七轮流程的快速审阅。",
        "inputs": [
          "待审文案"
        ],
        "outputs": [
          "词级替换/删除建议",
          "句段结构调整建议"
        ],
        "steps": [
          {
            "action": "词级：删减弱化词与填充词，把 utilize/leverage 换成 use、implement 换成 set up、facilitate 换成 help；对 innovative/cutting-edge、robust、seamless 这类词改为写出其代表的事实；留意副词、被动语态、名词化（如\"make a decision\"改\"decide\"）。",
            "when": "快速通道开始时。",
            "rationale": "同义替换只会造出新的 AI 痕迹，应回到事实。",
            "evidence": [
              {
                "path": "skills/copy-editing/SKILL.md",
                "section": "Word-Level Checks",
