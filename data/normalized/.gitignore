# Local complete prompts/transcripts can contain upstream material. Keep them on
# this machine; publish derived records, provenance and usage metadata separately.
**/attempts/**/request.txt
**/attempts/**/response.txt
**/attempts/**/events.jsonl
**/attempts/**/session.json
**/attempts/**/stderr.txt
**/.run.lock
**/execution.log
# Local quota/cooldown state persists across batches; never a credential store.
/.provider-routing-state.json
/.provider-routing-state.lock
/.provider-routing-state.tmp
# Corpus run bodies and full diagnostics remain local until separately licensed.
/full-*/batches/
/full-*/worker.log
/full-*/progress.json
/full-*/runtime.json
/full-*/recoveries/*/previous-states.jsonl.gz
