{"schema_version": "0.1.1", "source": {"collection_id": "5efa4f962e732e9ecbf4", "repository": "anthropics/skills", "commit_sha": "ca45fc496a3436251f191354091d557da31c15b5", "skill_path": "skills/brand-guidelines/SKILL.md", "git_blob_sha": "47c72c607bdb5dd81bdea5de2b5e4f3992a5fd59", "entry_sha256": "1120b3769e2985cefb3d25be981b1f914abeba57ae079b83c20c666c164fa9fe"}, "content": {"name": "brand-guidelines", "title": "应用 Anthropic 品牌视觉规范", "summary": "按该来源规定的颜色、字体及回退方式处理视觉制品，保留该品牌自身的视觉要求。", "evidence": [{"path": "skills/brand-guidelines/SKILL.md", "line_start": 3, "line_end": 3}, {"path": "skills/brand-guidelines/SKILL.md", "line_start": 17, "line_end": 31}, {"path": "skills/brand-guidelines/SKILL.md", "line_start": 62, "line_end": 68}], "tasks": [{"id": "t1", "goal": "为需要 Anthropic 视觉风格的制品应用品牌颜色和字体。", "when": "任务涉及品牌色、样式指南、视觉格式或该公司的设计标准。", "inputs": ["需要应用品牌样式的制品"], "outputs": ["应用该品牌视觉规范的制品"], "steps": [], "checks": [], "evidence": [{"path": "skills/brand-guidelines/SKILL.md", "line_start": 3, "line_end": 3}]}], "rules": [{"text": "主色包括深色 #141413、浅色 #faf9f5、中灰 #b0aea5 和浅灰 #e8e6dc；分别用于主要文字/深色背景、浅色背景/深色上的文字、次要元素和细微背景。", "when": null, "rationale": null, "evidence": [{"path": "skills/brand-guidelines/SKILL.md", "line_start": 17, "line_end": 31}]}, {"text": "强调色使用橙色 #d97757、蓝色 #6a9bcc、绿色 #788c5d；非文字形状使用强调色，并在橙、蓝、绿之间轮换。", "when": null, "rationale": null, "evidence": [{"path": "skills/brand-guidelines/SKILL.md", "line_start": 17, "line_end": 31}, {"path": "skills/brand-guidelines/SKILL.md", "line_start": 54, "line_end": 59}]}, {"text": "标题使用 Poppins；正文使用 Lora；原文将 24pt 及以上文字视作标题应用字体。", "when": null, "rationale": null, "evidence": [{"path": "skills/brand-guidelines/SKILL.md", "line_start": 32, "line_end": 37}, {"path": "skills/brand-guidelines/SKILL.md", "line_start": 40, "line_end": 46}]}, {"text": "自定义字体不可用时，标题回退 Arial，正文回退 Georgia；无需安装字体也能依靠回退方案工作。", "when": "Poppins 或 Lora 不可用时", "rationale": null, "evidence": [{"path": "skills/brand-guidelines/SKILL.md", "line_start": 62, "line_end": 68}]}, {"text": "保持文本层级和可读性；在背景之上选择适当的文字颜色。", "when": null, "rationale": null, "evidence": [{"path": "skills/brand-guidelines/SKILL.md", "line_start": 47, "line_end": 53}]}, {"text": "颜色使用 RGB 值；原文列举 python-pptx 的 RGBColor 类用于应用颜色。", "when": null, "rationale": null, "evidence": [{"path": "skills/brand-guidelines/SKILL.md", "line_start": 69, "line_end": 73}]}], "resources": [{"name": "Poppins / Lora 及 Arial / Georgia 回退字体", "kind": "environment", "locator": null, "usage": "为标题和正文提供原文指定的字体选择。", "evidence": [{"path": "skills/brand-guidelines/SKILL.md", "line_start": 32, "line_end": 37}]}, {"name": "python-pptx RGBColor", "kind": "tool", "locator": null, "usage": "原文列出的颜色应用接口。", "evidence": [{"path": "skills/brand-guidelines/SKILL.md", "line_start": 69, "line_end": 73}]}], "notes": []}, "extraction": {"language": "zh-CN", "scope": "entry_only", "files_read": [{"path": "skills/brand-guidelines/SKILL.md", "coverage": "full"}], "gaps": [{"target": "/content/tasks/0/steps", "reason": "not_stated", "detail": "入口以规则为主，没有明确给出完整、有序的制作流程。"}, {"target": "/content/tasks/0/checks", "reason": "not_stated", "detail": "入口未给出独立验收流程或可执行测试，未补造检查项。"}], "review_status": "unreviewed", "execution_status": "not_executed", "producer": "assistant-authored schema example; evidence and detail revision"}}
