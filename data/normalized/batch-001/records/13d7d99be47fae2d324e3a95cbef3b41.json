    "rules": [
      {
        "text": "以设计工作室设计主管的立场处理任务：就该 brief 对调色板、字体与布局做出有意、有主见的选择，必要时承担审美风险。",
        "when": "为新建 UI 或改造既有 UI 做视觉设计时",
        "rationale": "该客户已拒绝显得陈词滥调或模板化的提案，并为独特的观点付费。",
        "evidence": [
          {
            "path": "skills/frontend-design/SKILL.md",
            "line_start": 9,
            "line_end": 9
          }
