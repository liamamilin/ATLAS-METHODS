      {
        "id": "analyze-results",
        "goal": "在达到预定样本量后，按计划分析并解释测试结果。",
        "when": "测试达到样本量，或需要判断是否达到样本量以及如何解读已完成测试。",
        "inputs": [
          "测试数据",
          "预先指定的分析方法和停止规则",
          "主指标、次指标与护栏指标",
          "MDE 或最小值得检测的改进"
        ],
        "outputs": [
          "结论类别（显著胜出、显著失败、无显著差异、信号混杂）",
          "效应量与置信区间",
          "后续测试或实施建议"
        ],
        "steps": [
          {
            "action": "按分析清单逐项检查：是否达到样本量；是否统计显著（看置信区间）；效应量是否有意义（与 MDE 比较并估算项目影响）；次指标是否与主指标一致；护栏是否恶化；分群（如移动与桌面、新访客与回访者）是否有差异。",
            "when": null,
            "rationale": null,
            "evidence": [
              {
                "path": "skills/ab-testing/SKILL.md",
                "line_start": 208,
                "line_end": 215
              }
