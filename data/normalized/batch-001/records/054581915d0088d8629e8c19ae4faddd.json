      {
        "id": "maintain-learnings",
        "goal": "把上线后得到的决策与测试结论沉淀为 Learnings 表条目，并在失效时退役而非删除。",
        "when": "任一 Skill 完成测试、活动或复盘并有可复用的结论时；含定时运行的循环。",
        "inputs": [
          "测试/活动结果，含数字与样本量",
          "用户做出的带理由的决策",
          "用户重复给出的纠正"
        ],
        "outputs": [
          "Learnings 表新增行（Learning、Evidence、Applies to、Status）",
          "状态改为 retired 的退役行及原因"
        ],
        "steps": [
          {
            "action": "提出一行条目：Learning 用一句具体到能改变草稿的话；Evidence 写测试、活动或来源，并带数字与样本量；Applies to 写受影响的渠道、细分或 Skill；Status 取 active、watch（仅一个数据点、值得复测）或 retired。",
            "when": "有可入库的结论",
            "rationale": null
          },
          {
            "action": "把提议行展示给用户，获批准后加入，并像其他实质变更一样升版本、加一条 Changelog。",
            "when": "提议行准备好时",
            "rationale": null
          },
          {
            "action": "定时运行的循环通过其会话结束步骤执行同样的提议流程（见 marketing-loops）。",
            "when": "循环按计划运行时",
            "rationale": null
          },
          {
            "action": "判定条目失效时把状态改为 retired 并加一行说明原因，不删除；退役行移到底部，活动行超过约 20 行后归档。",
            "when": "后续测试与之矛盾、产品或市场发生变化（新定价、新 ICP），或已两个季度不再相关",
            "rationale": "避免他人重测已定论的问题"
          }
        ],
        "checks": [
