    "tasks": [
      {
        "id": "structured-root-cause-triage",
        "goal": "找出并修复导致失败或错误的根本原因，防止复发，并对修复做端到端验证。",
        "when": "测试因代码改动而失败、构建中断、运行时行为与预期不符、收到缺陷报告、日志或控制台出现错误、或此前可用的功能不再工作。",
        "inputs": [
          "错误输出、日志与堆栈",
          "复现步骤",
          "仓库自身的测试与构建命令",
          "版本历史（用于回归定位）"
        ],
        "outputs": [
          "已识别并记录的根因",
          "针对根因的修复",
          "能捕获该失败的回归测试",
          "端到端验证结果（特定测试、完整套件、构建）"
        ],
        "steps": [
          {
            "action": "停止新增功能或改动，保留证据（错误输出、日志、复现步骤），按分诊清单诊断，修复根因，防止复发，验证通过后才恢复工作。",
            "when": "出现任何意外：测试失败、构建中断、运行时错误或行为不符预期。",
            "rationale": "错误会累积；早期未修复的缺陷会使后续步骤建立在错误判断之上，例如第 3 步遗留的缺陷会让第 4–6 步都出错。",
            "evidence": [
              {
                "path": "skills/debugging-and-error-recovery/SKILL.md",
                "section": "The Stop-the-Line Rule",
                "line_start": 23,
                "line_end": 34
              }
            ]
          },
          {
            "action": "复现：让失败可靠发生；若无法复现，则收集更多上下文（日志、环境细节）并在最小环境中重试；确实不可复现时记录条件并持续监控。",
            "when": "进入分诊第 1 步，任何缺陷排查开始时。",
            "rationale": "无法复现就无法有信心地修复。",
            "evidence": [
