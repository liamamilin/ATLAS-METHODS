    "tasks": [
      {
        "id": "create-context",
        "goal": "产出一份 `.agents/product-marketing.md`（v1），记录产品、受众、定位与品牌声音等基础上下文。",
        "when": "项目中不存在该文档，用户要新建产品营销上下文时。",
        "inputs": [
          "`.agents/`、`.claude/` 下已有的上下文文件（含旧文件名 `product-marketing-context.md`）",
          "代码库中的 README、落地页、营销文案、about 页面、meta 描述、package.json、既有文档（自动起草时）",
          "用户对访谈问题的口述回答（从零开始时）"
        ],
        "outputs": [
          "`.agents/product-marketing.md`，含 Document version、Last updated、各章节与初始 Changelog"
        ],
        "steps": [
          {
            "action": "检查 `.agents/product-marketing.md`，同时检查 `.claude/product-marketing.md` 和旧文件名 `product-marketing-context.md`（两个目录都可能存在）；若在规范位置之外找到，提出把它迁移到 `.agents/product-marketing.md`。",
            "when": "开始创建前",
            "rationale": "兼容旧有安装位置"
          },
          {
            "action": "文档不存在时向用户提供两种方式：从代码库自动起草（推荐），或从零逐节访谈对话。",
            "when": "确认文档不存在",
            "rationale": "自动起草比从零开始更快，多数用户偏好该方式"
          },
          {
            "action": "自动起草时读取 README、落地页、营销文案、about 页、meta 描述、package.json 及既有文档，据此起草全部章节；从零时逐节进行：先简要说明该节记录什么，再提相关问题，确认准确后进入下一节，不要一次抛出所有问题。",
            "when": "用户选定创建方式后",
            "rationale": null
          },
          {
            "action": "展示草稿并问“哪些需要纠正？缺什么？”，按反馈迭代到用户满意。",
            "when": "自动起草完成后",
            "rationale": null
          },
          {
            "action": "按模板结构组织文档：Document version、Last updated、第 1–14 节，以及 Learnings 表和 Changelog 表。",
            "when": "信息收集完成",
            "rationale": null
          },
          {
            "action": "展示完整文档并询问是否需要调整；新文档设 `Document version: v1`，Changelog 只写一条 `- v1 ([today]) — Initial context.`；保存到 `.agents/product-marketing.md`。",
            "when": "保存前",
            "rationale": null
          },
          {
            "action": "告知用户其他营销 Skill 此后会自动使用该上下文，Changelog 追踪每次修订，可随时运行 `/product-marketing` 更新。",
            "when": "保存完成后",
            "rationale": null
          }
        ],
