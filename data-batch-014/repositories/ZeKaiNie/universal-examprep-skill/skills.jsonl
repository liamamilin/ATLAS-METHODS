{"id": "56fab7033091e46e4155", "repository": "ZeKaiNie/universal-examprep-skill", "commit_sha": "e01d2f7647b0917172ae8ad5fb788b404e977cae", "skill_path": "full/skills/exam-tutor/SKILL.md", "source_url": "https://github.com/ZeKaiNie/universal-examprep-skill/blob/e01d2f7647b0917172ae8ad5fb788b404e977cae/full/skills/exam-tutor/SKILL.md", "git_blob_sha": "29d9bb2c416c522f9b0748bc18e2eba4853f3475", "sha256": "b8f41a5ff53de916933fafacf049b469458a2b4418f23c5f2edab3ed3678a2b7", "bytes": 21730, "collected_at": "2026-11-06T11:13:12.559929+00:00", "state": "collected", "raw_path": "raw/ZeKaiNie/universal-examprep-skill/e01d2f7647b0917172ae8ad5fb788b404e977cae/full/skills/exam-tutor/SKILL.md", "execution_status": "not_executed", "quality_status": "not_evaluated", "license_candidates": ["LICENSE", "full/LICENSE"], "repository_manifest": "manifests/ZeKaiNie/universal-examprep-skill/e01d2f7647b0917172ae8ad5fb788b404e977cae.json", "local_package_files": ["full/skills/exam-tutor/SKILL.md"], "local_package_files_not_exported": [], "external_dependency_status": "not_fetched_or_verified", "path_review_hints": [], "frontmatter_raw": "name: exam-tutor\ndescription: >\n  按章节惰性加载授课：每次只读当前阶段的一个 wiki 章节，用生活隐喻讲概念、解剖公式；重点题固定走\n  题面图→问题→读图量→公式→演算→答案详解→溯源七步，画图题先运行算法。用于讲懂当前章或老师勾出的重点题。\nlicense: MIT", "declared_name": "exam-tutor", "format_status": "header_present_not_schema_validated"}
{"id": "d4986ee291eeedbdb04a", "repository": "ZeKaiNie/universal-examprep-skill", "commit_sha": "e01d2f7647b0917172ae8ad5fb788b404e977cae", "skill_path": "skills/universal-exam-cram-coach/SKILL.md", "source_url": "https://github.com/ZeKaiNie/universal-examprep-skill/blob/e01d2f7647b0917172ae8ad5fb788b404e977cae/skills/universal-exam-cram-coach/SKILL.md", "git_blob_sha": "4f9b6c67f6c82aa08a14a48e1a24c5b7226157c7", "sha256": "7607b9246c7a8676ebbea2b713f51486ea0e88635d8416a78993758375e2f67f", "bytes": 10561, "collected_at": "2026-11-06T11:13:12.560027+00:00", "state": "collected", "raw_path": "raw/ZeKaiNie/universal-examprep-skill/e01d2f7647b0917172ae8ad5fb788b404e977cae/skills/universal-exam-cram-coach/SKILL.md", "execution_status": "not_executed", "quality_status": "not_evaluated", "license_candidates": ["LICENSE", "skills/universal-exam-cram-coach/LICENSE"], "repository_manifest": "manifests/ZeKaiNie/universal-examprep-skill/e01d2f7647b0917172ae8ad5fb788b404e977cae.json", "local_package_files": ["skills/universal-exam-cram-coach/LICENSE", "skills/universal-exam-cram-coach/SKILL.md", "skills/universal-exam-cram-coach/coach.py", "skills/universal-exam-cram-coach/coach/__init__.py", "skills/universal-exam-cram-coach/coach/chapters.py", "skills/universal-exam-cram-coach/coach/cli.py", "skills/universal-exam-cram-coach/coach/extract.py", "skills/universal-exam-cram-coach/coach/figures.py", "skills/universal-exam-cram-coach/coach/guard.py", "skills/universal-exam-cram-coach/coach/index.py", "skills/universal-exam-cram-coach/coach/questions.py", "skills/universal-exam-cram-coach/coach/state.py", "skills/universal-exam-cram-coach/coach/text.py"], "local_package_files_not_exported": [], "external_dependency_status": "not_fetched_or_verified", "path_review_hints": [], "frontmatter_raw": "name: universal-exam-cram-coach\ndescription: \"临考复习教练 / Exam cram coach. 学生给一个课程资料文件夹（课件 PDF/PPTX/DOCX/笔记/作业/答案/真题/往年卷），它按章节讲解并标出处、把讲义和题目里的图裁出来展示、只用资料里的题考试判分、记错题和笔记、按天排复习计划、做小抄，并标明每句话是否来自资料。触发词：期末、期中、考试、备考、复习、突击、刷题、真题、作业讲解、错题本、划重点、小抄、复习计划、考研、考证、课件讲解、讲义。Use when a student wants to prepare for a final, midterm or any exam from their own course files: teach chapter by chapter with page citations and the figures cropped from the materials, quiz only from the homework and past papers, keep progress, mistakes and notes across chats, plan the remaining days, build a cheat sheet, and label what comes from the materials. Triggers: exam prep, cram, revise, study for the test, lecture slides, homework solutions, past papers, practice questions, quiz me, mistake log, cheat sheet, study plan, study guide, flashcards.\"\nlicense: MIT\ncompatibility: \"Python 3.8+ (standard library). Optional: pypdfium2 for PDF text and figure cropping. Works offline; needs no network access and no API keys.\"\nmetadata:\n  version: \"5.3\"\n  edition: flash\n  author: ZeKaiNie", "declared_name": "universal-exam-cram-coach", "format_status": "header_present_not_schema_validated"}
