        "when": "维护者要求查看需要其关注的事项时（如“Show me anything that needs my attention”）。",
        "inputs": [
          "议题跟踪器查询结果",
          "议题跟踪器配置（外部 PR 判定）"
        ],
        "outputs": [
          "三个桶的列表：未标注、needs-triage、自上次分诊记录后报告者有活动的 needs-info",
          "每项的计数与一行摘要"
        ],
        "steps": [
