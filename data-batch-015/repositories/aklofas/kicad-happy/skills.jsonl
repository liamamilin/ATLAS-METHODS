ad/scripts/summarize_findings.py", "skills/kicad/scripts/validation_detectors.py", "skills/kicad/scripts/what_if.py"], "local_package_files_not_exported": [], "external_dependency_status": "not_fetched_or_verified", "path_review_hints": [], "frontmatter_raw": "name: kicad\ndescription: >-\n  Analyze KiCad projects and PDF schematics: schematics, PCB layouts, Gerbers,\n  footprints, symbols, netlists, and design rules. Reviews designs for bugs,\n  traces nets, cross-references schematic to PCB, extracts BOM data, checks\n  DRC/ERC, DFM, power trees, and regulator circuits. Every finding carries a\n  confidence label and evidence source with trust_summary rollup. Analyzes PDF\n  schematics from dev boards, reference designs, eval kits, and datasheets.\n  Supports KiCad 5–10. Use whenever the user mentions .kicad_sch, .kicad_pcb,\n  .kicad_pro, PCB design review, schematic analysis, PDF schematics, reference\n  designs, Gerber files, DRC/ERC, netlist issues, BOM extraction, signal\n  tracing, power budget, DFM, or wants to understand, debug, compare, or\n  review any hardware design. Also for \"check my board\", \"review before fab\",\n  \"what's wrong with my schematic\", \"is this ready to order\", \"check my power\n  supply\", \"verify this circuit\", OSHWA certification readiness, or any\n  electronics/PCB design question.", "declared_name": "kicad", "format_status": "header_present_not_schema_validated"}
{"id": "c672e82c8a1c3ad0843a", "repository": "aklofas/kicad-happy", "commit_sha": "c451943f72d91a4a9fbf4aa48bda0f730011f6d8", "skill_path": "skills/lcsc/SKILL.md", "source_url": "https://github.com/aklofas/kicad-happy/blob/c451943f72d91a4a9fbf4aa48bda0f730011f6d8/skills/lcsc/SKILL.md", "git_blob_sha": "d975e41449784f0392e0660c762018dd079c822a", "sha256": "3bd900586c4bdeebb3ffc8ea624c2a5ff79da39ffa359801d17219e657397429", "bytes": 11901, "collected_at": "2026-11-06T11:16:24.987392+00:00", "state": "collected", "raw_path": "raw/aklofas/kicad-happy/c451943f72d91a4a9fbf4aa48bda0f730011f6d8/skills/lcsc/SKILL.md", "execution_status": "not_executed", "quality_status": "not_evaluated", "license_candidates": ["LICENSE"], "repository_manifest": "manifests/aklofas/kicad-happy/c451943f72d91a4a9fbf4aa48bda0f730011f6d8.json", "local_package_files": ["skills/lcsc/SKILL.md", "skills/lcsc/scripts/_core_path.py", "skills/lcsc/scripts/fetch_datasheet_lcsc.py", "skills/lcsc/scripts/provider_lcsc.py", "skills/lcsc/scripts/search_lcsc.py", "skills/lcsc/scripts/sync_datasheets_lcsc.py", "skills/lcsc/scripts/test_search_lcsc.py"], "local_package_files_not_exported": [], "external_dependency_status": "not_fetched_or_verified", "path_review_hints": [], "frontmatter_raw": "name: lcsc\ndescription: Search LCSC Electronics for electronic components — find parts by LCSC number (Cxxxxx) or MPN, check stock/pricing, download datasheets, analyze specifications. Sister company to JLCPCB, same parts library. Sync and maintain a local datasheets directory for a KiCad project, or use batch MPN-list seeding (`--mpn-list`) for bulk workflows without a project. No API key needed — uses the free jlcsearch community API. Use this skill when the user mentions LCSC, JLCPCB parts library, JLCPCB assembly parts, production sourcing, Cxxxxx part numbers, needs to find LCSC equivalents for parts, is preparing a BOM for JLCPCB assembly, or wants to download datasheets and LCSC is available. For package cross-reference tables and BOM workflow, see the `bom` skill.", "declared_name": "lcsc", "format_status": "header_present_not_schema_validated"}
