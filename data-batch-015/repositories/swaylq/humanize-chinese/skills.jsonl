"scripts/lr_coef_academic.json", "scripts/lr_coef_academic_with_nlpcc_2026-05-16.json", "scripts/lr_coef_cn.json", "scripts/lr_coef_cn_with_nlpcc_2026-05-16.json", "scripts/lr_coef_longform.json", "scripts/lr_coef_longform_with_nlpcc_2026-05-16.json", "scripts/ngram_freq_cn.json", "scripts/ngram_freq_cn_human_holdout.json", "scripts/ngram_model.py", "scripts/patterns_cn.json", "scripts/pipeline/fluency.py", "scripts/pipeline/guards.py", "scripts/pipeline/rhythm.py", "scripts/pipeline/run.py", "scripts/pipeline/stage2_rewrite.py", "scripts/pipeline/stage4_proofread.py", "scripts/replace_cn.py", "scripts/restructure_cn.py", "scripts/rewrite_cn.py", "scripts/style_cn.py", "scripts/train_lr_academic.py", "scripts/train_lr_longform.py", "scripts/train_lr_multisource.py", "scripts/train_lr_scorer.py", "scripts/train_ngram_human.py", "scripts/train_ngram_news.py", "scripts/train_ngram_wiki.py", "scripts/watermark_cn.py", "skills/deai-rewrite/SKILL.md", "skills/declaude-cn/SKILL.md", "skills/proofread-cn/SKILL.md", "skills/write-cn/SKILL.md", "tests/__init__.py", "tests/test_cli.py", "tests/test_prompts.py", "tests/test_proofread_guard.py", "tests/test_regression.py", "tests/test_replace.py", "tests/test_rhythm.py", "tests/test_watermark.py"], "local_package_files_not_exported": ["docs/assets/og.png", "scripts/cilin_synonyms.json"], "external_dependency_status": "not_fetched_or_verified", "path_review_hints": [], "frontmatter_raw": "name: humanize-chinese\ndescription: >\n  中文去 AI 腔一整套（装完即用，零 API Key —— 装了本 skill 的 agent 自己就是那个 LLM）。\n  六个流程：① 生成即去 AI —— 写中文时按本 skill 的写作指南落笔，初稿就不带 AI 腔；\n  ② 复查改写 —— 产出后对照本 skill 的清单再过一遍，定点拆模板句式；\n  ③ Python 词语替换 —— ./humanize replace 按文体自动路由词表（学术 120+ 条 /\n  通用 220+ 条），只做短语级、只在子句边界替换，改完自动核对数字/专名/段落；\n  ④ Claude 腔转中文 —— 把 Claude 助手腔的中文改写成平实中文，\n  规则提炼自 gvzdv/claudish-to-english 并本地化；\n  ⑤ 去水印 —— ./humanize watermark 扫清零宽字符/双向控制符/同形替身，\n  并对照 guillaumemeyer/watermarks-remover 说明统计水印的边界；\n  ⑥ 纠错顺句 —— 修错词、病句、标点，拗口和用词不准处轻手顺一顺；改动范围有硬校验。\n  另有检测（0-100 分）、风格转换、学术降重等 CLI。\n  Use when user says: \"去AI味\", \"降AIGC\", \"人性化文本\", \"humanize chinese\", \"AI检测\",\n  \"AIGC降重\", \"去除AI痕迹\", \"文本改写\", \"论文降重\", \"知网检测\", \"维普检测\", \"AI写作检测\",\n  \"让文字更自然\", \"detect AI text\", \"humanize text\", \"make text human-like\",\n  \"去ai化\", \"改成人话\", \"去机器味\", \"长文本改写\", \"小说改写\", \"写一篇\",\n  \"claudish\", \"去claude腔\", \"助手腔\", \"去水印\", \"watermark remover\", \"remove watermark\"\nallowed-tools:\n  - Read\n  - Write\n  - Edit\n  - exec", "declared_name": "humanize-chinese", "format_status": "header_present_not_schema_validated"}
{"id": "8104472dab9c6d0ddfc9", "repository": "swaylq/humanize-chinese", "commit_sha": "6510ca720b91919a12fa2e828b5ec959deb11db4", "skill_path": "skills/deai-rewrite/SKILL.md", "source_url": "https://github.com/swaylq/humanize-chinese/blob/6510ca720b91919a12fa2e828b5ec959deb11db4/skills/deai-rewrite/SKILL.md", "git_blob_sha": "5c282ee34a82c0aaebc2c6d8cb838da6d1fd3704", "sha256": "9421d607de52640bc425a6e3f8dc3f27051e1d9b5f1ca41617b7b645685185d4", "bytes": 5832, "collected_at": "2026-11-06T11:18:39.305742+00:00", "state": "collected", "raw_path": "raw/swaylq/humanize-chinese/6510ca720b91919a12fa2e828b5ec959deb11db4/skills/deai-rewrite/SKILL.md", "execution_status": "not_executed", "quality_status": "not_evaluated", "license_candidates": ["LICENSE"], "repository_manifest": "manifests/swaylq/humanize-chinese/6510ca720b91919a12fa2e828b5ec959deb11db4.json", "local_package_files": ["skills/deai-rewrite/SKILL.md"], "local_package_files_not_exported": [], "external_dependency_status": "not_fetched_or_verified", "path_review_hints": [], "frontmatter_raw": "name: deai-rewrite\nstage: 2\ndescription: >\n  给已经写好的中文去 AI 腔。六段流水线的第二段：输入可以是第一段的产物，\n  也可以是用户手上任何一篇 AI 生成的稿子。做法是定点修改，不是重写 ——\n  只动踩线的句子，没踩线的一个字不碰。它只能删掉 AI 腔，补不出人味。\n  这份文件和 write-cn 一样，刻意写成它要求的那种中文：\n  指令的版式会被模型当范文，清单腔教出清单腔。", "declared_name": "deai-rewrite", "format_status": "header_present_not_schema_validated"}
{"id": "7a68eb14dfd10ca464e7", "repository": "swaylq/humanize-chinese", "commit_sha": "6510ca720b91919a12fa2e828b5ec959deb11db4", "skill_path": "skills/declaude-cn/SKILL.md", "source_url": "https://github.com/swaylq/humanize-chinese/blob/6510ca720b91919a12fa2e828b5ec959deb11db4/skills/declaude-cn/SKILL.md", "git_blob_sha": "1c4350267112fd4ce9996f45c0608e2eb638d8d8", "sha256": "590bee46598752d00afb05fa6cba844ce30c58dbf07b0ccf35811551508f3f2f", "bytes": 2431, "collected_at": "2026-11-06T11:18:39.305815+00:00", "state": "collected", "raw_path": "raw/swaylq/humanize-chinese/6510ca720b91919a12fa2e828b5ec959deb11db4/skills/declaude-cn/SKILL.md", "execution_status": "not_executed", "quality_status": "not_evaluated", "license_candidates": ["LICENSE"], "repository_manifest": "manifests/swaylq/humanize-chinese/6510ca720b91919a12fa2e828b5ec959deb11db4.json", "local_package_files": ["skills/declaude-cn/SKILL.md"], "local_package_files_not_exported": [], "external_dependency_status": "not_fetched_or_verified", "path_review_hints": [], "frontmatter_raw": "name: declaude-cn\nstage: 4\ndescription: >\n  把 Claude 腔的中文改写成平实自然的中文。六段流水线的第四段：\n  专拆 Claude 的助手腔 —— 对话残留、客套、解释癖。稿子整体的 AI 模板句式归第二段管。\n  规则提炼自开源项目 gvzdv/claudish-to-english（2.4k star）的内置改写 prompt，\n  本地化成中文，由 agent 直接执行，不需要装它的插件。", "declared_name": "declaude-cn", "format_status": "header_present_not_schema_validated"}
{"id": "994bb3883124fa1a91aa", "repository": "swaylq/humanize-chinese", "commit_sha": "6510ca720b91919a12fa2e828b5ec959deb11db4", "skill_path": "skills/proofread-cn/SKILL.md", "source_url": "https://github.com/swaylq/humanize-chinese/blob/6510ca720b91919a12fa2e828b5ec959deb11db4/skills/proofread-cn/SKILL.md", "git_blob_sha": "9702a7f0a243f66c2b4cc8ad8b029444d689536f", "sha256": "660be3ce956d91f357bf5ff03ad2545ab93accb2b3b4168d734138bf6aa449ad", "bytes": 2421, "collected_at": "2026-11-06T11:18:39.305868+00:00", "state": "collected", "raw_path": "raw/swaylq/humanize-chinese/6510ca720b91919a12fa2e828b5ec959deb11db4/skills/proofread-cn/SKILL.md", "execution_status": "not_executed", "quality_status": "not_evaluated", "license_candidates": ["LICENSE"], "repository_manifest": "manifests/swaylq/humanize-chinese/6510ca720b91919a12fa2e828b5ec959deb11db4.json", "local_package_files": ["skills/proofread-cn/SKILL.md"], "local_package_files_not_exported": [], "external_dependency_status": "not_fetched_or_verified", "path_review_hints": [], "frontmatter_raw": "name: proofread-cn\nstage: 6\ndescription: >\n  六段流水线的第六段：纠错顺句。修四类东西 —— 错词、病句、标点，\n  以及读着拗口、语义不畅、用词不准的地方，轻手顺一顺。\n  不增删信息、不调句序、不做风格改造；写得没毛病的句子一个字不动。", "declared_name": "proofread-cn", "format_status": "header_present_not_schema_validated"}
{"id": "92ae17b66daeafbe0017", "repository": "swaylq/humanize-chinese", "commit_sha": "6510ca720b91919a12fa2e828b5ec959deb11db4", "skill_path": "skills/write-cn/SKILL.md", "source_url": "https://github.com/swaylq/humanize-chinese/blob/6510ca720b91919a12fa2e828b5ec959deb11db4/skills/write-cn/SKILL.md", "git_blob_sha": "6946c5dc22884b534f78e22a763b98b43226b47e", "sha256": "341de297ee4a7a69650a9a42b09a95ba5082637baa341d59f86f9ea581b6ec4c", "bytes": 9481, "collected_at": "2026-11-06T11:18:39.305917+00:00", "state": "collected", "raw_path": "raw/swaylq/humanize-chinese/6510ca720b91919a12fa2e828b5ec959deb11db4/skills/write-cn/SKILL.md", "execution_status": "not_executed", "quality_status": "not_evaluated", "license_candidates": ["LICENSE"], "repository_manifest": "manifests/swaylq/humanize-chinese/6510ca720b91919a12fa2e828b5ec959deb11db4.json", "local_package_files": ["skills/write-cn/SKILL.md"], "local_package_files_not_exported": [], "external_dependency_status": "not_fetched_or_verified", "path_review_hints": [], "frontmatter_raw": "name: write-cn\nstage: 1\ndescription: >\n  写中文的时候直接绕开 AI 腔，而不是写完再洗。给 LLM 当写作指令用：喂进题目和文体，\n  产出的初稿就已经没有模板句式、没有价值拔高骨架、没有等厚段落。\n  这是六段流水线的第一段。第一段决定文章有没有人味，后面几段只能修，补不出来。\n  这份文件本身刻意写成它要求的那种中文 —— 指令文档的版式和语气会被模型当范文模仿，\n  一份满是加粗和编号清单的规范，教出来的就是加粗和编号清单。", "declared_name": "write-cn", "format_status": "header_present_not_schema_validated"}
