    "rules": [
      {
        "text": "按 Hyrum 定律设计：用户足够多时，系统的所有可观察行为——包括未文档化的怪癖、错误消息文本、时序和顺序——都会成为事实契约。",
        "when": "决定暴露什么、以及是否改动可观察行为时",
        "rationale": "原文以此作为接口设计的第一原则。",
        "evidence": [
          {
            "path": "skills/api-and-interface-design/SKILL.md",
            "line_start": 22,
            "line_end": 26
          }
        ]
      },
      {
        "text": "对暴露面保持刻意：每个可观察行为都是一份潜在承诺；可被观察到的实现细节会被依赖，因此不要泄漏。",
        "when": "设计响应、错误信息与行为细节时",
        "rationale": null,
        "evidence": [
          {
            "path": "skills/api-and-interface-design/SKILL.md",
            "line_start": 28,
            "line_end": 29
          }
        ]
      },
      {
        "text": "在设计阶段就规划弃用；测试不足以保护——即使有完美的契约测试，Hyrum 定律意味着“安全”变更也可能破坏依赖未文档化行为的真实用户。",
        "when": "计划修改或移除公共行为时",
        "rationale": null,
        "evidence": [
          {
            "path": "skills/api-and-interface-design/SKILL.md",
            "line_start": 30,
            "line_end": 31
          }
        ]
