          },
          {
            "action": "若选择保留原样，报告保留的分支名与 worktree 路径。",
            "when": "人类伙伴选择保留分支时。",
            "rationale": null,
            "evidence": [
              {
                "path": "skills/finishing-a-development-branch/SKILL.md",
                "line_start": 128,
                "line_end": 130
              }
