    "tasks": [
      {
        "id": "define-interface-contract",
        "goal": "在实现之前定义稳定的接口契约：类型化的输入输出、单一错误语义、统一命名与边界校验，使接口难以被误用。",
        "when": "设计新 API 端点、定义模块边界或跨团队契约、创建组件 props 接口、由数据库 schema 决定 API 形状，或修改现有公共接口时。",
        "inputs": [
          "调用方需求与使用场景",
          "数据模型或数据库 schema",
          "现有公共接口及其调用方"
        ],
        "outputs": [
          "实现前写好的契约：接口/类型声明、错误响应结构、命名约定",
          "与实现一同提交的 API 文档或类型"
        ],
        "steps": [
          {
            "action": "先写契约再写实现：声明每个操作的输入、输出与语义——创建返回含服务端生成字段的对象；列表返回分页结果；单个获取失败抛 NotFoundError；更新为部分更新；删除幂等，重复删除也成功。",
            "when": "开始实现之前",
            "rationale": "契约即规范，实现跟随契约；类型本身就是文档。",
            "evidence": [
              {
                "path": "skills/api-and-interface-design/SKILL.md",
                "line_start": 37,
                "line_end": 59
              }
            ]
          },
          {
            "action": "选定一种错误策略并全局套用：REST 用 HTTP 状态码加统一错误体 { error: { code, message, details? } }，code 机器可读（如 VALIDATION_ERROR）、message 人类可读；500 不暴露内部细节。",
            "when": "定义端点错误响应时",
            "rationale": "若有的端点抛异常、有的返回 null、有的返回 { error }，调用方无法预测行为。",
            "evidence": [
              {
                "path": "skills/api-and-interface-design/SKILL.md",
                "line_start": 61,
                "line_end": 86
              }
            ]
          },
          {
            "action": "只在系统边界校验：API 路由处理、表单提交处理、外部服务响应解析、环境变量加载；第三方响应一律视为不可信，先校验形状与内容再用于逻辑、渲染或决策。",
            "when": "决定校验放在哪里时",
            "rationale": "内部代码共享类型契约、可信；边界是外部输入进入处。",
            "evidence": [
              {
                "path": "skills/api-and-interface-design/SKILL.md",
                "line_start": 88,
                "line_end": 123
              }
            ]
          },
          {
            "action": "演进接口时只做加法：追加可选字段，不修改已有字段类型、不删除字段。",
            "when": "要给已有接口增加能力时",
            "rationale": "改类型或删除字段会破坏现有消费者。",
            "evidence": [
              {
                "path": "skills/api-and-interface-design/SKILL.md",
                "line_start": 125,
                "line_end": 144
              }
            ]
          },
          {
            "action": "按统一约定命名：REST 端点用复数名词、不带动词；query 参数与响应字段用 camelCase；布尔字段用 is/has/can 前缀；枚举值用 UPPER_SNAKE。",
            "when": "命名端点、参数、字段、枚举时",
            "rationale": null,
            "evidence": [
              {
                "path": "skills/api-and-interface-design/SKILL.md",
                "line_start": 146,
                "line_end": 155
              }
            ]
          },
          {
            "action": "把 API 文档或类型与实现一同提交。",
            "when": "契约定稿并落地实现时",
            "rationale": null,
            "evidence": [
