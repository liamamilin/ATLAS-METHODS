        "steps": [
          {
            "action": "读取文档并总结已记录内容，特别注明当前 Document version 和最近几条 Changelog，让用户知道文档现状与近况。",
            "when": "文档已存在",
            "rationale": null
          },
          {
            "action": "询问用户想更新哪些章节，只收集这些章节所需的信息。",
