lls/verdikta-bounties-onboarding/scripts/test/fixtures/wager-testnet/20.rpc.json", "skills/verdikta-bounties-onboarding/scripts/test/fixtures/wager-testnet/20.status.json", "skills/verdikta-bounties-onboarding/scripts/test/fixtures/wager-testnet/21.job.json", "skills/verdikta-bounties-onboarding/scripts/test/fixtures/wager-testnet/21.rpc.json", "skills/verdikta-bounties-onboarding/scripts/test/fixtures/wager-testnet/21.status.json", "skills/verdikta-bounties-onboarding/scripts/test/fixtures/wager-testnet/22.job.json", "skills/verdikta-bounties-onboarding/scripts/test/fixtures/wager-testnet/22.rpc.json", "skills/verdikta-bounties-onboarding/scripts/test/fixtures/wager-testnet/22.status.json", "skills/verdikta-bounties-onboarding/scripts/test/fixtures/wager-testnet/23.job.json", "skills/verdikta-bounties-onboarding/scripts/test/fixtures/wager-testnet/23.rpc.json", "skills/verdikta-bounties-onboarding/scripts/test/fixtures/wager-testnet/23.status.json", "skills/verdikta-bounties-onboarding/scripts/test/fixtures/wager-testnet/24.job.json", "skills/verdikta-bounties-onboarding/scripts/test/fixtures/wager-testnet/24.rpc.json", "skills/verdikta-bounties-onboarding/scripts/test/fixtures/wager-testnet/24.status.json", "skills/verdikta-bounties-onboarding/scripts/test/fixtures/wager-testnet/25.job.json", "skills/verdikta-bounties-onboarding/scripts/test/fixtures/wager-testnet/25.rpc.json", "skills/verdikta-bounties-onboarding/scripts/test/fixtures/wager-testnet/25.status.json", "skills/verdikta-bounties-onboarding/scripts/test/lifecycle.test.js", "skills/verdikta-bounties-onboarding/scripts/test/origin.test.js", "skills/verdikta-bounties-onboarding/scripts/test/owner-withdraw.test.js", "skills/verdikta-bounties-onboarding/scripts/test/password.test.js", "skills/verdikta-bounties-onboarding/scripts/test/recover-close.test.js", "skills/verdikta-bounties-onboarding/scripts/test/wager-cli.test.js", "skills/verdikta-bounties-onboarding/scripts/test/wager-parity.test.js", "skills/verdikta-bounties-onboarding/scripts/test/wager-question.test.js", "skills/verdikta-bounties-onboarding/scripts/test/wager.test.js", "skills/verdikta-bounties-onboarding/scripts/test/work-order-result.test.js", "skills/verdikta-bounties-onboarding/scripts/test/work-order.test.js", "skills/verdikta-bounties-onboarding/scripts/validate_contract_config.js", "skills/verdikta-bounties-onboarding/scripts/wager.js", "skills/verdikta-bounties-onboarding/scripts/wallet_init.js", "skills/verdikta-bounties-onboarding/scripts/withdraw_to_owner.js"], "local_package_files_not_exported": [], "external_dependency_status": "not_fetched_or_verified", "path_review_hints": [], "frontmatter_raw": "name: verdikta-bounties-onboarding\ndescription: \"Verdikta Bounties hot-wallet operator for Base. Can create/import Ethereum keys into an encrypted keystore (its password is never stored; it comes from VERDIKTA_WALLET_PASSWORD via a secret store or a prompt), keep an API key, upload public bounty/work data, call the reviewed Verdikta API and Base RPC, and sign irreversible mainnet/testnet transactions within an owner spend policy. Use fresh low-balance wallets only. Commissions a verdikta-discover work-order draft when the owner approves it in chat with a line such as 'Approve <hash prefix>, payout <X> ETH, window <N>h': it binds that exact draft, writes approved.json and creates the bounty under the spend policy. Places mutual wagers (a bet with another wallet as two directed bounties, on a game or on a YES/NO question about a published value) only with node wager.js propose/answer/check/status/claim/close, posting only after the owner's line 'Approve wager <hash prefix>, stake <X> ETH, vs <opponent>, settle <ISO time>'. Withdraws the wallet's ETH (or leftover LINK) only to the owner address recorded at onboarding, when the owner asks.\"\nmetadata:\n  clawdbot:\n    emoji: \"⚖️\"\n    requires:\n      env:\n        - VERDIKTA_WALLET_PASSWORD\n        - VERDIKTA_NETWORK\n        - VERDIKTA_KEYSTORE_PATH\n        - VERDIKTA_SPEND_POLICY\n      anyBins:\n        - node\n        - npm\n    primaryEnv: VERDIKTA_WALLET_PASSWORD\n    files: [\"scripts/*\", \"references/*\"]\n    permissions:\n      filesystem:\n        read:\n          - \"~/.config/verdikta-bounties/.env\"\n          - \"~/.config/verdikta-bounties/verdikta-bounties-bot.json\"\n          - \"~/.config/verdikta-bounties/verdikta-wallet.json\"\n          - \"scripts/*.json\"\n          - \"../verdikta-discover/scripts/*\"\n          - \"../verdikta-discover/schemas/*\"\n          - \"../verdikta-discover/templates/*\"\n          - \"../verdikta-discover/node_modules/**\"\n          - \"operator-selected spend policy and approved work-order draft\"\n          - \"~/.config/verdikta-bounties/wager-defaults.json\"\n          - \"~/.config/verdikta-bounties/wagers/**\"\n        write:\n          - \"~/.config/verdikta-bounties/.env\"\n          - \"~/.config/verdikta-bounties/verdikta-bounties-bot.json\"\n          - \"~/.config/verdikta-bounties/verdikta-wallet.json\"\n          - \"~/.config/verdikta-bounties/wagers/**\"\n      network:\n        - \"https://bounties.verdikta.org\"\n        - \"https://bounties-testnet.verdikta.org\"\n        - \"https://mainnet.base.org\"\n        - \"https://sepolia.base.org\"\n      shell:\n        - \"node\"\n        - \"npm\"\n      crypto:\n        hotWalletSigning: true\n        chains: [\"base:8453\", \"base-sepolia:84532\"]\n        irreversibleTransactions: true", "declared_name": "verdikta-bounties-onboarding", "format_status": "header_present_not_schema_validated"}
