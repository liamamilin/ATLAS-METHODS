        "checks": [],
        "evidence": [
          {
            "path": "skills/copy-editing/SKILL.md",
            "section": "Core Philosophy",
            "line_start": 25,
            "line_end": 25
          }
        ]
      },
      {
        "id": "seven-sweeps",
        "goal": "按七个维度顺序扫读文案，每次只聚焦一个维度，并保证前序维度的成果不被后续编辑破坏。",
        "when": "模式为 A（空白或 AI 味重）或 B（有真实声音）时；点编辑不适用。",
        "inputs": [
          "待编辑文案",
          "产品营销上下文（如有）",
          "作者原有论点与用词（B 模式）"
        ],
        "outputs": [
          "逐轮标记的问题点与具体修改建议",
          "经七轮并回查后的编辑稿"
        ],
        "steps": [
          {
            "action": "清晰度轮：快速通读并标出不清楚处，先只记录问题不改，之后给出具体修改建议并确认修改保持原意；检查含混句式、代词指代不明、行话、歧义陈述、缺上下文。",
            "when": "第一轮。",
            "rationale": "句子承载过多、抽象、假设读者已知、把重点埋在限定语里都会损害清晰度。",
            "evidence": [
              {
                "path": "skills/copy-editing/SKILL.md",
                "section": "Sweep 1: Clarity",
                "line_start": 33,
                "line_end": 54
              }
            ]
          },
          {
            "action": "语气与声音轮：朗读以听出不一致，标记语气突变处，建议平滑过渡的改法并保持人格贯穿；检查正式/随意切换、品牌人格不一致、忽幽默忽严肃、技术语言随机出现、\"we\" 与 \"the company\" 混用。",
            "when": "第二轮。",
            "rationale": "声音不一致会让文案读起来割裂。",
            "evidence": [
              {
                "path": "skills/copy-editing/SKILL.md",
                "section": "Sweep 2: Voice and Tone",
                "line_start": 60,
                "line_end": 80
              }
            ]
          },
          {
            "action": "So What 轮：对每条主张逐句问\"那又怎样？\"，标出没有回答的，补上利益桥接或更深含义，并确认利益对接读者真实诉求；重点检查只有功能没有利益、有主张无后果、缺\"which means...\"衔接。",
            "when": "第三轮。",
            "rationale": "不回答\"为什么要在意\"的主张对读者无意义。",
            "evidence": [
              {
                "path": "skills/copy-editing/SKILL.md",
                "section": "Sweep 3: So What",
                "line_start": 88,
                "line_end": 113
              }
            ]
          },
          {
            "action": "证据轮：识别每条需要佐证的主张，查看附近是否已有证据，标记无支撑断言，建议补证据或弱化主张；可寻找的证据包括具名且有细节的证言、案例引用、统计数据、第三方背书、保证与风险逆转、客户 logo、评分。",
            "when": "第四轮。",
            "rationale": "\"Trusted by thousands\"/\"Industry-leading\" 这类说法缺少可核实的支撑。",
            "evidence": [
              {
                "path": "skills/copy-editing/SKILL.md",
                "section": "Sweep 4: Prove It",
                "line_start": 119,
                "line_end": 148
              }
            ]
          },
          {
            "action": "具体性轮：标出模糊词与短语，追问能否更具体，补数字、时间范围或例子；无法变具体的内容删除，视其为填充。",
            "when": "第五轮。",
            "rationale": "形容词在做名词该做的事、利益没有量化、结果没有时间范围都会削弱说服力。",
            "evidence": [
              {
                "path": "skills/copy-editing/SKILL.md",
                "section": "Sweep 5: Specificity",
                "line_start": 154,
                "line_end": 184
              }
            ]
          },
          {
            "action": "情绪轮：判断文案是否有情感冲击，找出本应共鸣却平淡的段落，在不失真的前提下加情绪质地，确保情绪服务于信息而非操纵；可用的情绪维度包括现状之痛、对替代方案的不满、错失恐惧、转变渴望、明智选择的骄傲、问题解决的解脱；手法包括生动描绘\"之前\"、感官语言、微故事、共同经历、引发反思的提问。",
            "when": "第六轮。",
            "rationale": "平铺直叙的信息语言让痛点只被提到而未被感受到。",
            "evidence": [
              {
                "path": "skills/copy-editing/SKILL.md",
                "section": "Sweep 6: Heightened Emotion",
                "line_start": 190,
                "line_end": 219
              }
            ]
          },
          {
            "action": "零风险轮：聚焦 CTA 附近，列出每个可能让人犹豫的理由，逐条检查文案是否回应，按需补风险逆转或信任信号；检查 CTA 附近摩擦、未回答的异议、缺信任信号、下一步不清、隐藏成本。",
            "when": "第七轮。",
            "rationale": "行动前的每个未解疑虑都是转化障碍。",
            "evidence": [
              {
                "path": "skills/copy-editing/SKILL.md",
                "section": "Sweep 7: Zero Risk",
                "line_start": 225,
                "line_end": 255
              }
            ]
          },
          {
            "action": "第七轮结束后按相反顺序把之前各轮再完整走一遍：情绪→具体性→证据→So What→语气→清晰度。",
            "when": "七轮全部完成后。",
            "rationale": "后续编辑可能破坏前序维度，需整体回检。",
            "evidence": [
              {
                "path": "skills/copy-editing/SKILL.md",
                "section": "Sweep 7: Zero Risk / 循环回查",
                "line_start": 257,
                "line_end": 257
              }
            ]
          }
        ],
        "checks": [
