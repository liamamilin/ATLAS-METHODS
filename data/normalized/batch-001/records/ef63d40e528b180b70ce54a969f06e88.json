    "tasks": [
      {
        "id": "draft-page-copy",
        "goal": "为指定页面撰写或改写营销文案，使主张清晰、可证且能推动行动。",
        "when": "用户要求为首页、落地页、定价页、功能页、关于页或产品页写文案、改写页面、改头条、写 CTA、写价值主张或标语，或说现有文案很弱、像 AI 写的。",
        "inputs": [
          "可选的产品营销上下文文件（.agents/product-marketing.md、.claude/product-marketing.md 或旧名 product-marketing-context.md），含 Learnings 章节",
          "页面类型与唯一的首要行动",
          "理想客户、其问题、异议与自述用语",
          "产品/报价、差异化、关键转变或结果、证明点（数字、证言、案例）",
          "流量来源与访客到达前的已知信息",
          "用户提供的草稿或写作样本（若有）"
        ],
        "outputs": [
          "一句话情境诊断及依据",
          "按版块组织的页面文案：头条、副标题、CTA、各节标题与正文、次级 CTA",
          "关键元素的选择说明与所应用原则",
          "头条与 CTA 的 2-3 个备选及理由",
          "相关时的页面标题与 meta description"
        ],
        "steps": [
          {
            "action": "先检查是否存在产品营销上下文文件并读取，然后只询问尚未覆盖或本任务特有的信息；起草前查看其 Learnings 章节，已测试过的角度与声明不再当作新想法提出，除非用户另有说明。",
            "when": "开始撰写之前",
            "rationale": "利用已有上下文，避免重复提出已被测试过的角度。",
            "evidence": [
              {
                "path": "skills/copywriting/SKILL.md",
                "section": "Before Writing",
                "line_start": 14,
                "line_end": 16
              }
            ]
          },
          {
            "action": "收集四类背景：页面类型与唯一首要行动；受众（理想客户、待解决问题、异议、自述语言）；产品/报价（卖什么、与替代方案的差异、关键转变、证明点）；上下文（流量来源、访客已知信息）。",
            "when": "信息未提供时询问补齐",
            "rationale": null,
            "evidence": [
              {
                "path": "skills/copywriting/SKILL.md",
                "section": "Before Writing",
                "line_start": 18,
                "line_end": 38
              }
            ]
          },
          {
            "action": "判定所处情境并用一行话写出诊断与证据：A 空白或泛泛内容（一线式请求或无观点的公司套话，可自定角度但不得编造数据、客户或结果）；B 存在真实声音（草稿已含角度、观点或可辨识语气，即使执行粗糙，应恢复而非替换）；C 定点修改（只改被要求之处及使其成立所需的最小周边改动）。",
            "when": "起草之前",
            "rationale": "多数糟糕的 AI 文案源于把模型口味强加给已做出良好选择的市场人员，因此诊断决定允许改动的幅度。",
            "evidence": [
              {
                "path": "skills/copywriting/SKILL.md",
                "section": "Diagnose the Situation First",
                "line_start": 42,
                "line_end": 52
              }
            ]
          },
          {
            "action": "在 B、C 情境中从输入读取品味：词汇是声音选择，用词不升级；着墨多寡是优先级选择，保留强调；省略的内容是范围选择，不加未要求的章节；角度即定位，只能深化不能替换。若给了写作样本，匹配其平均句长、标点习惯、段落开头和几个用户不会用的词；样本与默认声音冲突时以样本为准。",
            "when": "情境为 B 或 C，或用户提供写作样本",
            "rationale": null,
            "evidence": [
              {
                "path": "skills/copywriting/SKILL.md",
                "section": "Read taste out of the input",
                "line_start": 54,
                "line_end": 60
              }
            ]
          },
          {
            "action": "分解并锁定：不一次成稿，把页面拆为命名单元（头条、副标题、CTA、各节标题与正文、证明行）；每个单元写 2-3 个候选，保留最好的，修掉其最差缺陷后锁定；再组装并通读全页检查流畅度。B 情境中已经成立的行从一开始就锁定。",
            "when": "正式起草阶段",
            "rationale": null,
            "evidence": [
              {
                "path": "skills/copywriting/SKILL.md",
                "section": "Drafting Protocol",
                "line_start": 62,
                "line_end": 64
              }
            ]
          },
          {
            "action": "对每一行写或保留的文案过三问门槛：读者能否在脑中看见具体画面/场景/物件；声明能否被证真或证伪（不可证伪的最高级说法只是装饰）；竞争对手能否原句照搬（替换测试）。三问都过则保留；过两问则强化薄弱项；只过一问或全不过则依据事实重写，或用 [NEED: ...] 标出缺失信息。",
            "when": "每写完或保留一行时",
            "rationale": null,
            "evidence": [
              {
                "path": "skills/copywriting/SKILL.md",
                "section": "The three-question gate",
                "line_start": 66,
                "line_end": 71
              }
            ]
          },
          {
            "action": "节制力度：大多数行保持平实、具体、陈述式；整页只保留一到两个有力时刻，通常是头条和一个版块。",
            "when": "整页语气分配时",
            "rationale": "当每一行都想落在点上时，没有一行能落地，堆叠的修辞会读起来像 AI。",
            "evidence": [
              {
                "path": "skills/copywriting/SKILL.md",
                "section": "Ration the punch",
                "line_start": 73,
                "line_end": 73
              }
            ]
          },
          {
            "action": "交付前逐项检查每处改动：是否可衡量地更好，还是只是不同；给不出理由的改动回退。此检查在 B、C 情境最重要。",
            "when": "交付前",
            "rationale": null,
            "evidence": [
              {
                "path": "skills/copywriting/SKILL.md",
                "section": "The leave-it-alone test",
                "line_start": 75,
                "line_end": 75
              }
            ]
          },
          {
            "action": "只写来源材料支持的声明。被请求的声明缺乏支撑时：不写、也不静默删除；指出该声明、说明为何不足、给出最接近的可支撑替代，并明确写出什么证据可解锁原声明（客户评论导出、书面保障政策、认证、可引用的研究或数据集）。",
            "when": "遇到无法支撑的声明时",
            "rationale": "带解锁路径的被拒声明是客户可执行的行动项，没有路径则是死路。",
            "evidence": [
              {
                "path": "skills/copywriting/SKILL.md",
                "section": "Claims Must Be Supportable — and Declines Must Name Their Unlock",
                "line_start": 101,
                "line_end": 108
