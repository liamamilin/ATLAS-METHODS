  "content": {
    "name": "copy-editing",
    "title": "既有营销文案的七轮扫读编辑与 AI 痕迹清理",
    "summary": "针对用户已有的营销/转化文案做改进而非从零重写：先判断编辑模式（空白或 AI 味重的重建、有真实声音的复原、单点修改），点编辑跳过七轮扫读只改被要求处；完整模式按清晰度、语气、So What、证据、具体性、情绪、零风险七轮顺序扫读，每轮后回查前序轮次，最后跑 AI 痕迹检查。高价值文案可加 3-5 人专家面板 1-10 分打分，迭代到各人 7 分以上且均分 8 分以上。快速场景用词级/句级/段级检查替代完整流程；内容衰退时另有刷新框架。",
    "evidence": [
      {
        "path": "skills/copy-editing/SKILL.md",
        "section": "entry / Core Philosophy",
        "line_start": 1,
        "line_end": 31
      }
    ],
    "tasks": [
      {
        "id": "pick-edit-mode",
        "goal": "在动手前判断输入属于哪种编辑模式，并据此决定是否跑完整七轮扫读。",
        "when": "每次接到编辑/审阅/润色既有文案的请求时，先做模式判断。",
        "inputs": [
          "待编辑的既有文案",
          "若存在则读取的产品营销上下文（品牌声音、客户用语）"
        ],
        "outputs": [
          "选定的模式（A 空白或 AI 味重、B 有真实声音、C 单点修改）",
          "对应的编辑路径"
        ],
        "steps": [
          {
            "action": "先检查是否存在 .agents/product-marketing.md（或 .claude/product-marketing.md，老配置下为 product-marketing-context.md），存在则读取，用其中的品牌声音与客户语言指导编辑。",
            "when": "开始编辑之前。",
            "rationale": "让编辑贴合品牌语域与客户实际用语。",
            "evidence": [
              {
                "path": "skills/copy-editing/SKILL.md",
                "section": "Core Philosophy",
                "line_start": 14,
                "line_end": 15
              }
            ]
          },
          {
            "action": "诊断输入：A 为空白或充满 AI 味（从事实重建）；B 为有真实声音（恢复它并保留其论点与用词）；C 为单点修改（一行、一个词或一个段落）。",
            "when": "模式判断阶段。",
            "rationale": null,
            "evidence": [
              {
                "path": "skills/copy-editing/SKILL.md",
                "section": "Core Philosophy",
                "line_start": 25,
                "line_end": 25
              }
            ]
          }
        ],
        "checks": [
          {
            "text": "确认所选模式与输入相符；A、B 需跑完整七轮扫读，C 跳过七轮扫读。",
            "evidence": [
              {
                "path": "skills/copy-editing/SKILL.md",
                "section": "Core Philosophy",
                "line_start": 25,
                "line_end": 25
              }
            ]
          }
        ],
        "evidence": [
          {
            "path": "skills/copy-editing/SKILL.md",
            "section": "Core Philosophy",
            "line_start": 14,
            "line_end": 25
          }
        ]
