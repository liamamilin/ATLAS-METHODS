{"id": "1c80c26639c8c9612b38", "repository": "michaelshimeles/rstack", "commit_sha": "11b15767d7587bab11f6c4957507b5f26d1785c7", "skill_path": "unslop/SKILL.md", "source_url": "https://github.com/michaelshimeles/rstack/blob/11b15767d7587bab11f6c4957507b5f26d1785c7/unslop/SKILL.md", "git_blob_sha": "000b036a77a5d6a8570594772b1e38744b66f2ca", "sha256": "c861ee8c94debe24e28fe3f7d567883ed95ad9741fb8a4227fe217db8667fa78", "bytes": 6758, "collected_at": "2026-11-06T12:43:24.685612+00:00", "state": "collected", "raw_path": "raw/michaelshimeles/rstack/11b15767d7587bab11f6c4957507b5f26d1785c7/unslop/SKILL.md", "execution_status": "not_executed", "quality_status": "not_evaluated", "license_candidates": ["unslop/LICENSE"], "repository_manifest": "manifests/michaelshimeles/rstack/11b15767d7587bab11f6c4957507b5f26d1785c7.json", "local_package_files": ["unslop/LICENSE", "unslop/SKILL.md"], "local_package_files_not_exported": [], "external_dependency_status": "not_fetched_or_verified", "path_review_hints": [], "frontmatter_raw": "name: unslop\ndescription: Cut AI tells from text you write or edit for a human reader (commit messages, PR titles and bodies, docs, code comments, replies). Apply before committing, posting, or sending; leave prose you didn't touch alone.", "declared_name": "unslop", "format_status": "header_present_not_schema_validated"}
